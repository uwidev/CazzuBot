# Copy to .env and fill in. The bot serves ONE guild.

# Discord bot token (dev). Production uses TOKEN.
TOKEN_DEV=your_dev_bot_token_here
TOKEN=your_production_bot_token_here

# Your user id (the bot owner).
OWNER_ID=123456789012345678

# The two guilds this bot serves. Ids live in .env (gitignored) so they
# never land in the repo; --bot/--guild pick which side is used.
GUILD_ID_PROD=your_production_guild_id_here
GUILD_ID_DEV=your_development_guild_id_here

# Optional: additional users allowed to run commands in debug mode.
DEBUG_USERS=

# Optional: per-guild sqlite database files (development and production
# data stay in separate files).
# DB_PATH_PROD=data/cazzubot-prod.db
# DB_PATH_DEV=data/cazzubot-dev.db

# Optional: the dedicated asset child-guild that hosts every asset, shared by
# both served guilds. Media blobs (species art) CDN-publish into its private
# channel; custom emoji assets are created in the guild and referenced by
# <:name:id>. Without them the bot boots and skips the sync with a warning.
# ASSET_GUILD_ID=123456789012345678
# ASSET_CHANNEL_ID=123456789012345678
