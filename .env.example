# Copy to .env and fill in. The bot serves ONE guild.

# Discord bot token (dev). Production uses TOKEN.
TOKEN_DEV=your_dev_bot_token_here
TOKEN=your_production_bot_token_here

# Your user id (the bot owner).
OWNER_ID=123456789012345678

# The one server this bot serves.
GUILD_ID=123456789012345678

# Optional: additional users allowed to run commands in debug mode.
DEBUG_USERS=

# Optional: sqlite database file location.
# DB_PATH=data/cazzubot.db
